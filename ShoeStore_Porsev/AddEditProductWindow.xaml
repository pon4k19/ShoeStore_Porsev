<Window x:Class="ShoeStore_Porsev.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Porsev"
        mc:Ignorable="d"
        Title="Добавление/редактирование товара" Height="700" Width="900"
        Icon="/ботинки/Icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#7FFF00" Padding="15,10" Margin="10">
            <TextBlock Text="Управление товаром" FontSize="24" HorizontalAlignment="Center" FontFamily="Times New Roman"/>
        </Border>
        <Grid Grid.Row="1" Margin="50,20,50,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IdLabel" Grid.Row="0" Grid.Column="0" Text="ID товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding id_Product}" IsReadOnly="True" Margin="0,5,0,5" Background="#F0F0F0"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Фото товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,10"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="80" Height="60" BorderBrush="Gray" BorderThickness="1" Background="White">
                    <Image Stretch="Uniform" Name="PhotoImg" Source="{Binding Photo}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button Name="SelectImageBtn" Content="Выбрать изображение" Click="SelectImageBtn_Click" HorizontalAlignment="Left" Padding="5,2"/>
                    <TextBox Text="{Binding Photo}" IsReadOnly="True" Margin="0,5,0,0" HorizontalAlignment="Stretch" Name="FileNameTB"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <ComboBox x:Name="ProductNameCB" Grid.Row="2" Grid.Column="1" 
          SelectedItem="{Binding ProductName}" 
          DisplayMemberPath="ProductName1" 
          Margin="0,5,0,5"/>
            <!-- 2. Категория товара -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <!-- ПРОВЕРЬ: название свойства для SelectedItem и DisplayMemberPath -->
            <ComboBox x:Name="CategoryCB" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Category}" DisplayMemberPath="CategoryName" Margin="0,5,0,5"/>


            <!-- 3. Описание товара -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Описание товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Description}" Margin="0,5,0,5"/>

            <!-- 4. Производитель товара -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Производитель товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <ComboBox x:Name="ManufacturerCB" Grid.Row="5" Grid.Column="1" SelectedItem="{Binding Manufacturer}" DisplayMemberPath="ManufacturerName" Margin="0,5,0,5"/>

            <!-- 5. Поставщик товара -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Поставщик товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <ComboBox x:Name="ProviderCB" Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Provider}" DisplayMemberPath="ProviderName" Margin="0,5,0,5"/>

            <!-- 6. Цена товара -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Цена товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Price}" Margin="0,5,0,5"/>

            <!-- 7. Единица измерения товара -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Единица измерения товара" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Unit, TargetNullValue='шт.'}" IsReadOnly="True" Margin="0,5,0,5" />

            <!-- 8. Количество товара на складе -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Количество товара на складе" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Stock}" Margin="0,5,0,5"/>

            <!-- 9. Действующая скидка -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Действующая скидка" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Discount}" Margin="0,5,0,5"/>

            <!-- 10. Кнопка Сохранить -->
            <Button Grid.Row="11" Grid.Column="1" Content="Сохранить данные" Click="SaveBtn_Click" HorizontalAlignment="Center" Width="150" Margin="0,20,0,0" Padding="5,5"/>
        </Grid>
    </Grid>
</Window>