<Window x:Class="ShoeStore_Porsev.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Porsev"
        mc:Ignorable="d"
        Title="ООО Обувь - Список товаров" Height="600" Width="1000"
        Icon="/ботинки/Icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#7FFF00" CornerRadius="15" Margin="25,25,25,0" Padding="20" Height="100" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Name="BackBTN" Content="Выйти из системы" Height="30" Click="BackBTN_Click"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="ботинки\Icon.png" Width="100" Height="50" HorizontalAlignment="Center"/>
                    <TextBlock Text="Список товаров" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Times New Roman"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Name="FIOTB" Text="ФИО" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#7FFF00" CornerRadius="15" Padding="20">
            <StackPanel Orientation="Horizontal">
                <Label Name="SearchLB" Content="Поиск: " Height="30"/>
                <TextBox Name="SearchTB" Width="120" Height="20" HorizontalAlignment="Center" Margin="0 0 5 0" TextChanged="SearchTB_TextChanged"/>
                <GroupBox Name="GrpBx" Header="Сортировка (по кол-ву на складе)" Width="250">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="OrderByBtn" Content="По возрастанию" Width="110" Height="20" Margin="5 0 5 0" Click="OrderByBtn_Click"/>
                        <Button Name="OrderByDesBtn" Content="По убыванию" Width="110" Height="20" Margin="5 0 5 0" Click="OrderByDesBtn_Click"/>
                    </StackPanel>
                </GroupBox>
                <Label Name="PrdLB" Content="Поставщик: " Height="30"/>
                <ComboBox Name="PrdCB" Width="120" Height="20" HorizontalAlignment="Center" Margin="0 0 5 0" DisplayMemberPath="ProviderName" SelectedValuePath="id_Provider" SelectionChanged="PrdCB_SelectionChanged" />
                <Button Name="RstBt" Content="Сбросить фильтры" Width="110" Height="20" Margin="5 0 5 0" Click="RstBt_Click"/>
                <Button Name="AddBt" Content="Добавить товар" Width="110" Height="20" Margin="5 0 5 0" Click="AddBt_Click"/>
                <Button Name="DeleteBt" Content="Удалить товар" Width="110" Height="20" Margin="5 0 5 0" Click="DeleteBt_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <ListView Name="ListTovar" VirtualizingPanel.ScrollUnit="Pixel" Grid.Row="2" MouseDoubleClick="ListTovar_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_discount}" Value="True">
                            <Setter Property="Background" Value="#2e8b57"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding is_quantity}" Value="True">
                            <Setter Property="Background" Value="Cyan"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="550"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderThickness="2" Margin="5"
                                    BorderBrush="Black">
                                <Image Source="{Binding Photo}" Margin="10" Width="120"/>
                            </Border>
                            <Border Grid.Column="1" BorderThickness="1" Margin="5" BorderBrush="Black">
                                <StackPanel Margin="5" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category.CategoryName}" FontWeight="Bold"/>
                                        <TextBlock Text=" | " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ProductName.ProductName1}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: "/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: "/>
                                        <TextBlock Text="{Binding Manufacturer.ManufacturerName}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: "/>
                                        <TextBlock Text="{Binding Provider.ProviderName}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding Price}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="5 0 0 0" Text="{Binding price_discount, StringFormat=Новая цена: {0} руб.}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: "/>
                                        <TextBlock Text="{Binding Unit}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: "/>
                                        <TextBlock Text="{Binding Stock}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderThickness="2" Margin="5"
                                    BorderBrush="Black">
                                <StackPanel>
                                    <TextBlock Text="Действующая скидка: " VerticalAlignment="Top" TextWrapping="Wrap" Margin="5" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Discount}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
