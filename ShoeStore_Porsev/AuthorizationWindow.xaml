<Window x:Class="ShoeStore_Porsev.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Porsev"
        mc:Ignorable="d"
        Title="ООО Обувь - Авторизация" Height="450" Width="800"
        Icon="ботинки\Icon.ico">
    <Grid>
        <Border Background="#7FFF00" CornerRadius="15" Margin="25,25,25,0" Padding="20" Height="100" VerticalAlignment="Top">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"  Source="ботинки\Icon.png"
                    Margin="0,0,20,0"/>
                <TextBlock Grid.Column="1" Text="Авторизация" FontSize="36" 
                       VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Times New Roman"/>
            </Grid>
        </Border>
        <Grid Margin="255,149,255,100">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Логин" VerticalAlignment="Bottom" FontSize="16" FontFamily="Times New Roman"/>
            <TextBox Grid.Row="1" Name="LoginTB"/>
            <TextBlock Grid.Row="2" Text="Пароль" VerticalAlignment="Bottom" FontSize="16" FontFamily="Times New Roman"/>
            <PasswordBox Grid.Row="3" Name="PasswordTB"/>
            <Button Grid.Row="5" Content="Войти" FontSize="16" FontFamily="Times New Roman" Click="Button_Click"/>
            <Button Grid.Row="7" Margin="70,0,70,0" Content="Войти как гость" FontSize="16" FontFamily="Times New Roman"/>
        </Grid>
    </Grid>
</Window>
