<Window x:Class="ShoeStore_Porsev.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Porsev"
        mc:Ignorable="d"
        Title="Добавление/редактирование заказа" Height="500" Width="700"
        Icon="/ботинки/Icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="15,10" Margin="10">
            <TextBlock Text="Управление заказом" FontSize="24"
                       HorizontalAlignment="Center" FontFamily="Times New Roman"/>
        </Border>

        <Grid Grid.Row="1" Margin="50,20,50,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IdLabel" Grid.Row="0" Grid.Column="0" Text="ID заказа"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding id_Order}"
                     IsReadOnly="True" Margin="0,5,0,5" Background="#F0F0F0"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Артикул заказа"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OrderNumber}" Margin="0,5,0,5"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Статус заказа"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <ComboBox x:Name="StatusCB" Grid.Row="2" Grid.Column="1"
                      SelectedItem="{Binding Status}"
                      DisplayMemberPath="StatusName"
                      Margin="0,5,0,5"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Адрес пункта выдачи"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <ComboBox x:Name="PickupPointCB" Grid.Row="3" Grid.Column="1"
                      SelectedItem="{Binding PickupPoint}" Margin="0,5,0,5">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding City.CityName, Mode=OneWay}"/><Run Text=", "/>
                            <Run Text="{Binding Street.StreetName, Mode=OneWay}"/><Run Text=", д. "/>
                            <Run Text="{Binding HouseNumber, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата заказа"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding OrderDate}" Margin="0,5,0,5"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата выдачи"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,20,5"/>
            <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding DeliveryDate}" Margin="0,5,0,5"/>

            <Button Grid.Row="6" Grid.Column="1" Content="Сохранить данные"
                    Click="SaveBtn_Click" HorizontalAlignment="Center" Width="150"
                    Margin="0,20,0,0" Padding="5,5"/>
        </Grid>
    </Grid>
</Window>